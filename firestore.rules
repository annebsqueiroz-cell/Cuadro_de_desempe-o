rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidTurma(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.teacherName is string && data.teacherName.size() <= 200 &&
             data.schoolName is string && data.schoolName.size() <= 200 &&
             data.monthlyGoal is number &&
             (!('starEmoji' in data) || (data.starEmoji is string && data.starEmoji.size() <= 50)) &&
             (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128));
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.password is string && data.password.size() <= 200;
    }

    function isValidStudent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.turmaId is string && data.turmaId.size() <= 128 &&
             data.active is bool;
    }

    function isValidSticker(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.emoji is string && data.emoji.size() <= 50 &&
             data.label is string && data.label.size() <= 100 &&
             data.activityTitle is string && data.activityTitle.size() <= 300 &&
             data.timestamp is string && data.timestamp.size() <= 100 &&
             data.monthKey is string && data.monthKey.size() <= 30;
    }

    match /turmas/{turmaId} {
      allow read: if true;
      allow create, update: if isValidId(turmaId) && isValidTurma(request.resource.data);
      allow delete: if isValidId(turmaId);
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(request.resource.data);
      allow delete: if isValidId(studentId);
    }

    match /stickers/{stickerId} {
      allow read: if true;
      allow create, update: if isValidId(stickerId) && isValidSticker(request.resource.data);
      allow delete: if isValidId(stickerId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isValidId(userId);
    }

    match /app_settings/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
